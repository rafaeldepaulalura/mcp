# Servidor MCP do Licitante Prime — copie para .env (NUNCA commite o .env).

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# URL pública deste servidor (sem /mcp). O endpoint MCP fica em ${MCP_PUBLIC_URL}/mcp
MCP_PUBLIC_URL=https://mcp.licitanteprime.com.br
# Opcional: URI canônica do recurso (audiência dos tokens). Padrão: ${MCP_PUBLIC_URL}/mcp
# MCP_RESOURCE_URL=https://mcp.licitanteprime.com.br/mcp

# WordPress (servidor de autorização + API somente leitura)
OAUTH_ISSUER=https://licitanteprime.com.br
LICITANTE_PRIME_API_URL=https://licitanteprime.com.br/wp-json/lp-ai/v1
# Opcionais (derivados dos dois acima):
# OAUTH_JWKS_URL=https://licitanteprime.com.br/wp-json/lp-ai/v1/oauth/jwks
# OAUTH_METADATA_URL=https://licitanteprime.com.br/.well-known/oauth-authorization-server

# Segredo compartilhado MCP -> WordPress. O MESMO valor de LP_AI_MCP_INTERNAL_KEY no WordPress.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LP_INTERNAL_API_KEY=troque-por-um-valor-aleatorio-de-32-ou-mais-caracteres

# Tempo máximo de espera pela API do WordPress (ms)
WP_API_TIMEOUT_MS=12000

# Hosts aceitos no cabeçalho Host (padrão: host de MCP_PUBLIC_URL)
# ALLOWED_HOSTS=mcp.licitanteprime.com.br

# Origens de navegador liberadas (só para MCP Inspector no modo direto). Vazio = nenhuma.
# CORS_ALLOWED_ORIGINS=http://localhost:6274

# Primeira barreira contra enxurrada (o limite por usuário oficial fica no WordPress)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UNAUTH_PER_MINUTE=60

# Quantos proxies na frente (Traefik do EasyPanel = 1)
TRUST_PROXY_HOPS=1

# Tamanho máximo do corpo das requisições MCP (bytes)
MAX_BODY_BYTES=65536

# /metrics só responde com "Authorization: Bearer <METRICS_TOKEN>". Vazio = desligado.
# METRICS_TOKEN=

# Somente desenvolvimento local sem HTTPS. Nunca em produção.
# ALLOW_INSECURE_HTTP=false
